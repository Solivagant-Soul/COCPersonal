# COCPersonal 组合栈（web + api + postgres）的环境变量模板。
#
# 用法：
#   cp .env.example .env      # 填上标了「必填」的项
#   docker compose up -d --build
#
# .env 已被 .gitignore 忽略。**不要把填好的 .env 提交进仓库** ——
# 密钥一旦进了 git 历史，之后删文件也删不掉。

# --------------------------------------------------------------------------- #
# postgres
# --------------------------------------------------------------------------- #
POSTGRES_DB=coc
POSTGRES_USER=coc
# 必填。数据库只挂在 compose 内网，但仍是最后一道门，别用弱口令。
POSTGRES_PASSWORD=

# --------------------------------------------------------------------------- #
# api
# --------------------------------------------------------------------------- #
# all / api / collector。单副本部署固定 all（API 与采集调度器同进程）。
APP_ROLE=all

# Supercell API Token。
#
# **留空 = 开发夹具模式**：不打官方 API，改由 backend/app/coc/fixtures/ 的占位响应应答，
# 界面与接口契约都能跑通，但数据是手搓的（响应里带 _source / _todo 自报身份）。
# 拿到真实 Token 后填在这里。Token 绝不入库，只在这份 .env 里。
COC_API_TOKEN=

# 上游地址。留空 = 官方 https://api.clashofclans.com/v1。
# 服务器没有静态 IP 时填 RoyaleAPI 代理：https://cocproxy.royaleapi.dev/v1
# （代理只换域名转发，路径与鉴权不变；此时 Supercell key 的 Allowed IP
#   要填代理的 45.79.218.79，不是服务器 IP）
COC_BASE_URL=

# 对 Supercell 的令牌桶速率（次/秒）。走共享免费代理时不要调高。
COC_RATE_LIMIT=8
COC_TIMEOUT=15

# War Report（赛季榜 / 阵容）。无需 Key；上游要求署名，见 docs/deployment.md §12。
# 第三方只读 API，与本机的 Supercell Token、白名单都无关。不设这两行即用代码默认值；
# **别写成空值**：`WARREPORT_TIMEOUT=` 会让 Settings() 在导入期直接抛 ValidationError（进程起不来），
# `WARREPORT_BASE_URL=` 则让每次采集都以 WarReportError（URL 缺协议）失败 —— API 本身不受影响，
# 但赛季榜/阵容永远停在旧数据。（compose 的 ${VAR:-默认} 会把空值换回默认，直接跑 uvicorn/cli 没有这层保护。）
WARREPORT_BASE_URL=https://api.warreport.app
WARREPORT_TIMEOUT=15

# 对外每 IP 每分钟请求数。/healthz 与 /readyz 豁免。
RATE_LIMIT_PER_MINUTE=60

# 站点对外的绝对地址，用于拼投稿图片的绝对 URL。必填。
# 先只开 80 就填 http://<服务器IP>；上了 HTTPS 改成 https://<域名>。
#
# **这个值同时决定对外端口**：deploy/compose.sh 从它解析出端口（没写端口就是
#   http→80 / https→443），再交给 docker compose 发布。所以：
#   - 想换端口就改这里 → http://1.2.3.4:7788 → 对外 7788
#   - **用 deploy/compose.sh 启动**（`./deploy/compose.sh up -d`）；
#     直接 `docker compose up -d` 会回落到 80 端口。
PUBLIC_BASE_URL=

# 后台管理员。三项都必填（凭据只从环境变量读，不入库、没有 create-admin 命令）。
ADMIN_USERNAME=
ADMIN_PASSWORD=
# session cookie 的签名密钥，**必须换成随机值**：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET_KEY=

LOG_LEVEL=INFO
