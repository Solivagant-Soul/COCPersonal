COC_API_TOKEN=
# 上游地址。留空 = 官方 https://api.clashofclans.com/v1。
# 走 RoyaleAPI 代理（免自建 IP 白名单）时填：
#   COC_BASE_URL=https://cocproxy.royaleapi.dev/v1
# 代理只换域名，路径与你自己的 Supercell key 都不变。
COC_BASE_URL=
DATABASE_URL=
APP_ROLE=
COC_RATE_LIMIT=
COC_TIMEOUT=
MEDIA_ROOT=
PUBLIC_BASE_URL=
LOG_LEVEL=

# 后台管理员（R3：只从环境变量读，不入库、无角色模型）
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 后台 session cookie 的签名密钥。**必须改成随机值**：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET_KEY=

# 对外每 IP 每分钟请求数（/healthz 与 /readyz 豁免）
RATE_LIMIT_PER_MINUTE=60
